---
import Icon from './Icon.astro';
import { pathFor, text, type Locale } from '../lib/i18n';
const { locale } = Astro.props as { locale: Locale };
---
<section class="subscribe-card"><div class="subscribe-heading"><Icon name="rss" /><h3>{text(locale, '订阅技术更新', 'Subscribe to new posts')}</h3></div><p>{text(locale, '通过 RSS 按语言和标签订阅，用你自己的阅读器接收更新。', 'Choose a language and topic, and receive new posts in your own RSS reader.')}</p><a class="text-link" href={pathFor(locale, 'subscribe')}>{text(locale, '选择订阅内容', 'Choose your feed')}<Icon name="arrow" /></a></section>
