---
import Icon from './Icon.astro';
import { siteConfig } from '../config';
import { pathFor, feedUrl, tags, text, type Locale } from '../lib/i18n';
const { locale } = Astro.props as { locale: Locale };
const t = (zh: string, en: string) => text(locale, zh, en);
const absolute = (path: string) => new URL(path, siteConfig.url).href;
---
<main id="main" class="wrap"><section class="page-intro"><div class="eyebrow">FOLLOW AT YOUR OWN PACE</div><h1>{t('订阅技术更新', 'RSS subscriptions')}</h1><p>{t('中英文分开更新，也可以只关注感兴趣的标签。', 'Separate feeds for each language. Follow everything or choose a topic.')}</p></section><section class="subscription-page" aria-label={t('选择订阅', 'Choose a feed')}><div class="subscription-picker"><h2>{t('选择语言和范围', 'Choose a language and topic')}</h2><p>{t('复制地址到你的 RSS 阅读器，或直接打开下方订阅源。', 'Copy the URL into your RSS reader, or open one of the feeds below.')}</p><div class="rss-filters"><label for="rss-language">{t('内容语言', 'Content language')}<select id="rss-language"><option value="zh" selected={locale === 'zh'}>中文</option><option value="en" selected={locale === 'en'}>English</option></select></label><label for="rss-tag">{t('订阅范围', 'Topic')}<select id="rss-tag"><option value="all" data-zh="全部文章" data-en="All articles">{t('全部文章', 'All articles')}</option>{tags.map(tag => <option value={tag.id} data-zh={tag.zh} data-en={tag.en}>{tag[locale]}</option>)}</select></label></div><code class="feed-url" data-feed-url tabindex="0">{absolute(feedUrl(locale))}</code><div class="dialog-actions"><button class="button" data-copy-feed><Icon name="copy" />{t('复制订阅地址', 'Copy feed URL')}</button><a class="button secondary" data-open-feed href={feedUrl(locale)}>{t('查看 RSS 文件', 'Open RSS feed')}<Icon name="external" /></a></div><p data-copy-status role="status" aria-live="polite"></p></div><div class="feed-directory"><h2>{t('所有订阅源', 'All feeds')}</h2><p>{t('每个地址长期固定；同一篇文章可能出现在多个相关标签中。', 'Feed addresses are stable. A post can appear in more than one relevant topic.')}</p><div class="table-scroll"><table><thead><tr><th scope="col">{t('主题', 'Topic')}</th><th scope="col">中文</th><th scope="col">English</th></tr></thead><tbody><tr><th scope="row">{t('全部文章', 'All articles')}</th><td><a href={feedUrl('zh')}>中文 RSS</a></td><td><a href={feedUrl('en')}>English RSS</a></td></tr>{tags.map(tag => <tr><th scope="row"><a href={pathFor(locale, `tags/${tag.id}`)}>{tag[locale]}</a></th><td><a href={feedUrl('zh', tag.id)} aria-label={`${tag.zh} · 中文 RSS`}>中文 RSS</a></td><td><a href={feedUrl('en', tag.id)} aria-label={`${tag.en} · English RSS`}>English RSS</a></td></tr>)}</tbody></table></div></div></section></main>
