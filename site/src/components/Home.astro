---
import Icon from './Icon.astro';
import PostRow from './PostRow.astro';
import SubscribeCard from './SubscribeCard.astro';
import { siteConfig } from '../config';
import { readingMinutes, type Post } from '../lib/content';
import { pathFor, postUrl, tags, tagName, text, type Locale } from '../lib/i18n';
const { locale, posts } = Astro.props as { locale: Locale; posts: Post[] };
const t = (zh: string, en: string) => text(locale, zh, en);
const featured = posts.find(p => p.data.featured) || posts[0];
const recent = posts.filter(p => p !== featured).slice(0, 3);
const hasPlatforms = siteConfig.platforms.some(p => p.url) || (siteConfig.wechat.name && siteConfig.wechat.qrImage);
---
<main id="main">
  <section class="hero" aria-labelledby="hero-title"><img class="hero-art" src="/images/summer-sky.webp" srcset="/images/summer-sky-768.webp 768w, /images/summer-sky.webp 1536w" sizes="100vw" alt="" width="1536" height="512" fetchpriority="high" decoding="async" /><div class="wrap hero-inner"><div class="eyebrow hello">{t('HELLO, WORLD. 这里是 DB PATCH', 'HELLO, WORLD. THIS IS DB PATCH')}</div><h1 id="hero-title">{t('认真对待数据，', 'Taking data seriously.')}<br />{t('分享技术与', 'Sharing what ')}<span>{t('实践。', 'I learn.')}</span></h1><p class="hero-intro">{t('一名数据库运维与后端开发者的技术笔记。', 'Technical notes from a database operator and backend developer.')}<br />{t('写 PostgreSQL，写后端工程，也探索 AI 带来的新可能。', 'PostgreSQL, backend engineering, and practical experiments with AI.')}</p><div class="hero-buttons"><a class="button" href="#latest">{t('浏览最新笔记', 'Browse latest notes')}<Icon name="arrow" /></a></div><div class="hero-foot mono"><span>DATABASES. CODE. A LITTLE CURIOSITY.</span></div></div></section>
  <div class="wrap home-content"><div class="main-column">
    {featured && <section aria-labelledby="featured-title"><div class="section-head"><h2 id="featured-title">{t('值得一读', 'Worth a read')}<span class="eyebrow">FEATURED</span></h2><span class="small-label">{t('从这里开始', 'Start here')}</span></div><a class="featured" href={postUrl(featured)}><div class="featured-top"><Icon name="pin" />{featured.data.tags.map(id => tagName(id, locale)).join(' · ')}{featured.data.sample && ` · ${t('示例', 'SAMPLE')}`}</div><h3>{featured.data.title}</h3><p>{featured.data.excerpt}</p><div class="featured-bottom"><div class="meta"><time datetime={featured.data.date}>{featured.data.date.replaceAll('-', '.')}</time><span class="dot"></span><span>{t(`约 ${readingMinutes(featured)} 分钟`, `${readingMinutes(featured)} min read`)}</span></div><span class="round-arrow"><Icon name="arrow" /></span></div></a></section>}
    <section class="post-list" id="latest" aria-labelledby="latest-title"><div class="section-head"><h2 id="latest-title">{t('最近在写', 'Recent writing')}<span class="eyebrow">LATEST NOTES</span></h2>{posts.length > 0 && <a class="text-link" href={pathFor(locale, 'articles')}>{t('全部文章', 'All posts')}<Icon name="arrow" /></a>}</div>{recent.length ? recent.map((post, index) => <PostRow post={post} index={index} />) : <div class="empty-state"><h3>{posts.length ? t('更多笔记，慢慢更新。', 'More notes to come.') : t('第一篇笔记，正在准备。', 'The first note is on its way.')}</h3><p>{t('你可以先订阅，发布后会出现在阅读器里。', 'Subscribe to receive the next post in your reader.')}</p></div>}</section>
  </div><aside class="sidebar" aria-label={t('作者与订阅', 'Author and subscriptions')}>
    <section class="profile"><div class="profile-kicker"><span class="status-dot"></span>BEHIND THE PATCH</div><div class="profile-title"><div class="avatar" aria-hidden="true">db</div><div><h2>DB PATCH</h2><p>{siteConfig.author.role[locale]}</p></div></div><p class="profile-copy">{t('关心数据库是否稳妥，', 'I care about reliable databases')}<br />{t('也好奇下一行代码能做些什么。', 'and what the next line of code can do.')}<br />{t('这里存放技术笔记、实践和新想法。', 'These are my notes, experiments, and ideas.')}</p><div class="profile-code">$ whoami<br />postgresql · backend · ai</div>{hasPlatforms && <div class="social-mini"><a href={pathFor(locale, 'about') + '#platforms'} aria-label={t('所有平台', 'All platforms')}><Icon name="external" /></a></div>}</section>
    <section class="sidebar-section"><div class="sidebar-heading"><h3>{t('顺着标签逛逛', 'Browse by tag')}</h3></div><div class="tag-cloud">{tags.map(tag => <a href={pathFor(locale, `tags/${tag.id}`)}>{tag[locale]} <span>{posts.filter(p => p.data.tags.includes(tag.id)).length}</span></a>)}</div></section>
    <SubscribeCard locale={locale} />
  </aside></div>
</main>
