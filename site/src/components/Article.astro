---
import { render } from 'astro:content';
import Icon from './Icon.astro';
import { readingMinutes, type Post } from '../lib/content';
import { pathFor, tagName, text } from '../lib/i18n';
const { post, alternate } = Astro.props as { post: Post; alternate?: string };
const { data } = post;
const locale = data.lang;
const t = (zh: string, en: string) => text(locale, zh, en);
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<div class="read-progress" aria-hidden="true"></div>
<main id="main" class="wrap"><article data-pagefind-body><div class="article-top"><nav class="breadcrumb" aria-label={t('当前位置', 'Breadcrumb')}><a href={pathFor(locale)}>{t('首页', 'Home')}</a><span aria-hidden="true">/</span><a href={pathFor(locale, 'articles')}>{t('文章', 'Articles')}</a><span aria-hidden="true">/</span><span>{tagName(data.tags[0], locale)}</span></nav><header class="article-header"><div class="eyebrow">{data.category || tagName(data.tags[0], locale)}</div><h1>{data.title}</h1><p class="description">{data.excerpt}</p><div class="meta"><span>DB PATCH</span><span class="dot"></span><time datetime={data.date}>{data.date.replaceAll('-', '.')}</time>{data.updated && data.updated !== data.date && <span>{t('更新于', 'Updated')} <time datetime={data.updated}>{data.updated.replaceAll('-', '.')}</time></span>}<span class="dot"></span><span>{t(`约 ${readingMinutes(post)} 分钟`, `${readingMinutes(post)} min read`)}</span>{data.tags.map(tag => <a class="pill" href={pathFor(locale, `tags/${tag}`)}># {tagName(tag, locale)}</a>)}</div><p class="article-translation"><span>{t('语言版本：中文', 'Language: English')}</span>{alternate ? <><span>·</span><a href={alternate} lang={locale === 'zh' ? 'en' : 'zh-CN'}>{t('Read in English', '阅读中文版')}</a></> : <span class="muted">{t('（暂无英文译文）', '(Chinese translation not available)')}</span>}</p></header></div>
  <div class="article-layout"><div class="article-main"><details class="mobile-toc"><summary>{t('本文目录', 'On this page')}</summary>{toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</details><div class="article-content" id="article-content">{(data.context || data.sample) && <div class="article-context">{data.sample && <div class="eyebrow">{t('示例文章 · 非生产实测记录', 'SAMPLE ARTICLE · NOT A PRODUCTION REPORT')}</div>}{data.context}</div>}<Content /></div><div class="article-end"><a class="text-link" href={pathFor(locale, 'articles')}>{t('返回文章列表', 'Back to articles')}<Icon name="arrow" /></a><button class="share-link" data-share><Icon name="copy" />{t('复制文章链接', 'Copy article link')}</button></div></div><aside class="article-toc" aria-label={t('阅读工具与目录', 'Reading tools and contents')}><div class="toc-title">{t('本文目录', 'ON THIS PAGE')}</div><ol id="toc-links">{toc.map((h, i) => <li class:list={{ 'toc-subheading': h.depth === 3 }}><a href={`#${h.slug}`}><span>{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>)}</ol><div class="reading-tools"><button id="font-toggle" aria-pressed="false">{t('宋体阅读', 'Serif reading')}</button><button id="font-size" aria-label={t('增大正文字号', 'Increase font size')} aria-pressed="false">A＋</button></div><section class="sidebar-section"><a class="text-link" href={pathFor(locale, 'subscribe') + `?tag=${data.tags[0]}`}><Icon name="rss" />{t('订阅这个主题', 'Subscribe to this topic')}</a></section></aside></div>
</article></main>
