---
import PostRow from './PostRow.astro';
import Icon from './Icon.astro';
import SubscribeCard from './SubscribeCard.astro';
import type { Post } from '../lib/content';
import { pathFor, tags, tagName, text, type Locale } from '../lib/i18n';
const { locale, posts, tag } = Astro.props as { locale: Locale; posts: Post[]; tag?: string };
const t = (zh: string, en: string) => text(locale, zh, en);
const selected = tag ? posts.filter(p => p.data.tags.includes(tag)) : posts;
const title = tag ? `# ${tagName(tag, locale)}` : t('所有文章', 'All articles');
---
<main id="main" class="wrap"><section class="page-intro"><div class="eyebrow">{tag ? 'TOPIC ARCHIVE' : 'NOTES & ARCHIVE'}</div><h1>{title}</h1><p>{tag ? t('同一主题下的技术笔记与实践。', 'Notes and experiments on this topic.') : t('关于数据库、后端和 AI 的记录，按时间整理。', 'Notes on databases, backend engineering, and AI, in date order.')}</p></section><div class="archive-layout"><section aria-label={t('文章列表', 'Article list')}><nav class="filter-bar" aria-label={t('按标签浏览', 'Browse by tag')}><a class="filter-chip" href={pathFor(locale, 'articles')} aria-current={!tag ? 'page' : undefined}>{t('全部', 'All')}<span class="count">{posts.length}</span></a>{tags.map(item => <a class="filter-chip" href={pathFor(locale, `tags/${item.id}`)} aria-current={tag === item.id ? 'page' : undefined}>{item[locale]}<span class="count">{posts.filter(p => p.data.tags.includes(item.id)).length}</span></a>)}</nav><div class="year-head"><h2>{title}</h2><span>{t(`${selected.length} 篇笔记`, `${selected.length} articles`)}</span></div><div class="tag-subscription"><a class="text-link" href={pathFor(locale, 'subscribe') + (tag ? `?tag=${tag}` : '')}><Icon name="rss" />{tag ? t('订阅此标签', 'Subscribe to this tag') : t('订阅全部文章', 'Subscribe to all articles')}</a><span class="small-label">{t('中文', 'English')}</span></div><div class="archive-results">{selected.length ? selected.map((post, index) => <PostRow post={post} index={index} />) : <div class="empty-state"><h3>{t('这里还没有发布文章', 'No articles published here yet')}</h3><p>{t('新笔记发布后，会同时加入这个列表和对应的 RSS。', 'New posts will appear here and in the corresponding RSS feed.')}</p></div>}</div></section><aside class="archive-aside"><h2>{t('记录，也便于重访', 'Notes worth returning to')}</h2><p>{t('保留问题的背景、尝试过的方法，以及最后的判断。', 'Keep the context, the approaches tried, and the reasoning behind the result.')}</p><SubscribeCard locale={locale} /></aside></div></main>
